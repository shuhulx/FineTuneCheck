<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    {% if plotly_inline %}<script>{{ plotly_inline | safe }}</script>{% else %}<script src="{{ plotly_src }}"></script>{% endif %}
    <style>
        body { margin: 0; background: #f8fafc; color: #334155; font-family: Inter, system-ui, sans-serif; }
        main { max-width: 1080px; margin: 0 auto; padding: 32px 24px 56px; }
        h1 { color: #0f172a; margin-bottom: 4px; }
        .card { background: white; border-radius: 12px; padding: 24px; margin: 20px 0; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .summary { line-height: 1.65; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { padding: 11px 12px; text-align: left; border-bottom: 1px solid #e2e8f0; }
        th { color: #64748b; font-size: 11px; text-transform: uppercase; }
        code { overflow-wrap: anywhere; }
        .pareto { color: #047857; font-weight: 700; }
        footer { color: #64748b; font-size: 12px; text-align: center; }
    </style>
</head>
<body><main>
    <h1>{{ title }}</h1>
    <p>Base model: <code>{{ comparison.base_model }}</code></p>
    <div class="card summary">
        <strong>Comparison summary</strong>
        <p>{{ comparison.recommendation }}</p>
        <p>Best overall: {{ comparison.best_run }} · Best target: {{ comparison.best_target_perf }} · Least forgetting: {{ comparison.least_forgetting }}</p>
    </div>
    {% if figure %}<div class="card"><div id="comparison-chart" style="min-height:460px"></div></div>{% endif %}
    <div class="card">
        <table>
            <thead><tr><th>Run</th><th>Model</th><th>Verdict</th><th>Target delta</th><th>BWT</th><th>ROI</th><th>Coverage</th><th>Pareto</th></tr></thead>
            <tbody>
            {% for point in points %}
                <tr>
                    <td>{{ point.name }}</td><td><code>{{ point.model }}</code></td><td>{{ point.verdict }}</td>
                    <td>{{ "%+.3f" | format(point.target) if point.target is not none else 'Unavailable' }}</td>
                    <td>{{ "%+.3f" | format(point.bwt) if point.bwt is not none else 'Unavailable' }}</td>
                    <td>{{ "%.1f" | format(point.roi) if point.roi is not none else 'Unavailable' }}</td>
                    <td>{{ "%.0f%%" | format(point.coverage * 100) }}</td>
                    <td class="{{ 'pareto' if point.pareto else '' }}">{{ 'Yes' if point.pareto else 'No' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <footer>Generated by FineTuneCheck v{{ version }}. Comparison requires matching base, probes, judges, targets, and schemas.</footer>
</main>
{% if figure %}<script>if (typeof Plotly !== 'undefined') { Plotly.newPlot('comparison-chart', {{ figure.data | tojson }}, {{ figure.layout | tojson }}, {responsive:true, displayModeBar:false}); }</script>{% endif %}
</body></html>
